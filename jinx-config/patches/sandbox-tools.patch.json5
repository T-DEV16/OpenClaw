{
  tools: {
    sandbox: {
      tools: {
        alsoAllow: [
          // research
          "web_search",
          "web_fetch",
          "browser",
          // memory
          "memory_get",
          "memory_search",
          // goals / planning
          "create_goal",
          "get_goal",
          "update_goal",
          "update_plan",
          "progress_card",
          "ask_user",
          // messaging (lets it text you on Telegram proactively)
          "message",
          // voice
          "tts",
          "node_inference",
          // media / documents
          "view_image",
          "pdf",
          // file transfer
          "file_fetch",
          "dir_list",
          "dir_fetch",
          // Exact approved MCP tools. Do not use bundle-mcp or group:plugins:
          // those would also admit newly installed tools without review.
          "jinx-gmail-readonly__gmail_search",
          "jinx-gmail-readonly__gmail_get_message",
          "jinx-gmail-readonly__gmail_get_thread",
          "jinx-calendar-readonly__calendar_events",
          "jinx-calendar-write__calendar_create",
          "jinx-calendar-write__calendar_update",
        ],
      },
    },
  },
}
