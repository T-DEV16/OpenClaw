{
  tools: {
    exec: {
      pathPrepend: ["/usr/local/bin", "/Users/tarundevesetti/.nvm/versions/node/v24.19.0/bin"],
    },
    // Host-escape for Apple Reminders/Notes (those CLIs cannot run in Linux Docker).
    // Locked to TRAW's Telegram id only.
    elevated: {
      enabled: true,
      allowFrom: {
        telegram: ["7842220023"],
      },
    },
  },
  agents: {
    defaults: {
      heartbeat: {
        every: "1h",
        activeHours: {
          start: "07:00",
          end: "23:00",
          timezone: "America/Los_Angeles",
        },
      },
    },
  },
}
