{
  agents: {
    defaults: {
      model: {
        // Codex first. If it fails before the turn is underway, walk Gemini
        // then local gemma4. A later failure in a turn that already got a
        // successful model response does not restart on the next model.
        primary: "openai/gpt-5.6-sol",
        fallbacks: [
          "google/gemini-3.5-flash",
          "google/gemini-2.5-flash",
          "google/gemini-3.1-flash-lite",
          "ollama/gemma4",
        ],
      },
    },
  },
}
